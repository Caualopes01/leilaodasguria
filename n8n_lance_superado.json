{
  "name": "Lance Superado (WhatsApp)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "lance_novo",
        "responseMode": "onReceived",
        "options": {}
      },
      "name": "Webhook Supabase",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [100, 300]
    },
    {
      "parameters": {
        "url": "=SUPABASE_URL_AQUI/rest/v1/lances?produto_id=eq.{{$json.body.record.produto_id}}&order=valor.desc&limit=2",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "SUPABASE_KEY_AQUI" },
            { "name": "Authorization", "value": "Bearer SUPABASE_KEY_AQUI" }
          ]
        },
        "options": {}
      },
      "name": "Buscar Lances",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [300, 300]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $input.all().length > 1 && $input.all()[0].json.whatsapp != $input.all()[1].json.whatsapp }}",
              "value2": true
            }
          ]
        }
      },
      "name": "Foi Superado por Outro?",
      "type": "n8n-nodes-base.if",
      "executeOnce": true,
      "typeVersion": 1,
      "position": [500, 300]
    },
    {
      "parameters": {
        "url": "=SUPABASE_URL_AQUI/rest/v1/produtos?id=eq.{{$json.produto_id}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "SUPABASE_KEY_AQUI" },
            { "name": "Authorization", "value": "Bearer SUPABASE_KEY_AQUI" }
          ]
        },
        "options": {}
      },
      "name": "Buscar Produto",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [700, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "EVOLUTION_URL_AQUI/message/sendText/EVOLUTION_INSTANCE_AQUI",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "EVOLUTION_KEY_AQUI" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { number: $('Buscar Lances').all()[1].json.whatsapp.startsWith('55') || $('Buscar Lances').all()[1].json.whatsapp.startsWith('598') ? $('Buscar Lances').all()[1].json.whatsapp : '55' + $('Buscar Lances').all()[1].json.whatsapp, text: (() => { const isUy = $('Buscar Lances').all()[1].json.whatsapp.startsWith('598'); const vA = $('Buscar Lances').all()[1].json.valor; const vN = $('Buscar Lances').all()[0].json.valor; const rawNome = $('Buscar Lances').all()[1].json.nome; const nome = rawNome ? rawNome.split(' ')[0] : 'Guria'; const t = $json.titulo; const s = $json.slug; return isUy ? `¡Uy ${nome}, parece que alguien te está desafiando hoy! 🫣\n\n¡Tu oferta de R$ ${vA} en el producto *${t}* acaba de ser superada por una oferta de R$ ${vN}!\n\nCorre para no perder el artículo:\nhttps://leilao-das-gurias.vercel.app/leilao/${s}` : `Iiihh ${nome}, parece que alguém está te desafiando hoje! 🫣\n\nO seu lance de R$ ${vA} no produto *${t}* acabou de ser superado por um lance de R$ ${vN}!\n\nCorra para não perder a peça:\nhttps://leilao-das-gurias.vercel.app/leilao/${s}`; })() } }}",
        "options": {}
      },
      "name": "Enviar WhatsApp",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [900, 200]
    }
  ],
  "connections": {
    "Webhook Supabase": {
      "main": [
        [ { "node": "Buscar Lances", "type": "main", "index": 0 } ]
      ]
    },
    "Buscar Lances": {
      "main": [
        [ { "node": "Foi Superado por Outro?", "type": "main", "index": 0 } ]
      ]
    },
    "Foi Superado por Outro?": {
      "main": [
        [ { "node": "Buscar Produto", "type": "main", "index": 0 } ]
      ]
    },
    "Buscar Produto": {
      "main": [
        [ { "node": "Enviar WhatsApp", "type": "main", "index": 0 } ]
      ]
    }
  }
}
